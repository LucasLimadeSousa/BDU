<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".login.CadastroActivity">

    <!-- Header Azul -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_background"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Botão Voltar e Título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_backReturn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/card_border"
                    android:contentDescription="@string/voltar"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/black" />

            </LinearLayout>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                app:srcCompat="@drawable/ic_person"
                app:tint="@color/unifor_blue" />

            <!-- Campos de Cadastro -->
            <EditText
                android:id="@+id/inputNome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/hint_nome_completo"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/label_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputConfEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/hint_confirmar_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/label_senha"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputConfSenha"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/hint_confirmar_senha"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <!-- Requisitos de Senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_senha_deve_ter"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/senha_req_1"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/senha_req_2"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/senha_req_3"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="12sp" />

            <!-- Outros Dados -->
            <EditText
                android:id="@+id/inputCpf"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/label_cpf"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputTelefone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/label_telefone"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputCurso"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_border"
                android:hint="@string/label_curso"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputCidade"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_border"
                    android:hint="@string/hint_cidade"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputEstado"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_border"
                    android:hint="@string/label_estado"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_data_nascimento"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/inputDataNascimento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/card_border"
                android:hint="@string/hint_data_nascimento"
                android:inputType="date"
                android:paddingHorizontal="12dp"
                android:textColor="#000000"
                android:textColorHint="#000000"
                android:textSize="14sp" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_border"
                android:padding="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
            
                <CheckBox
                    android:id="@+id/checkboxTermos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/termosLink"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Li e aceito os termos e condições"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/blue_background"
                android:text="@string/btn_finalizar_cadastro"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>