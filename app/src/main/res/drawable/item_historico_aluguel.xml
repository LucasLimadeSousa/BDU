<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_history_item"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(NOME DO LIVRO):"
        android:textColor="@color/unifor_blue"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/tvHistoryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Em posse"
        android:textColor="#FFA500"
        android:textSize="9sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvHistoryDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alugado em: DD/MM/AAAA"
        android:textSize="9sp"
        android:textColor="#888888"/>

    <TextView
        android:id="@+id/tvHistoryReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Devolver em ATÉ (Dias)"
        android:textSize="8sp"
        android:textColor="#888888"/>
</LinearLayout>