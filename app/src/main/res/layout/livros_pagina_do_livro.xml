<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".paginaDoLivroActivity">

    <!-- Header Azul (Baseado na Foto 2) -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_background"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Página do Livro"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Botão Voltar Enquadrado -->
            <ImageButton
                android:id="@+id/btnBackLivro"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_border"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/black" />

            <!-- Título do Livro -->
            <TextView
                android:id="@+id/tvBookTitleMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="TÍTULO DO LIVRO"
                android:textAllCaps="true"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Card 1: Capa e Informações Principais (Borda em volta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_border"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Capa -->
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="160dp"
                        android:background="@drawable/card_border"
                        android:padding="1dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_report_image" />

                    <!-- Detalhes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Autor: Nome do autor"
                            android:textColor="@android:color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Gênero: Gênero do livro"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Data de publicação: DD/MM/AAAA"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Cópias disponíveis: ?"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botão Lista de Desejos -->
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="124dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Lista de Desejos"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    app:icon="@drawable/ic_heart"
                    app:iconTint="@android:color/black"
                    app:strokeColor="@android:color/black" />
            </LinearLayout>

            <!-- Card 2: Sinopse (Borda em volta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_border"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sinopse do Livro"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@android:color/darker_gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aqui vai o texto da sinopse. Uma breve descrição sobre a obra e o que o leitor pode esperar desta história fascinante e envolvente."
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Card 3: Dados Técnicos (Borda em volta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_border"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISBN: (Código)"
                    android:textColor="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Editora: (Nome da editora)"
                    android:textColor="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Páginas: (Número)"
                    android:textColor="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Idioma: (Idioma)"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Botão Alugar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlugar"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/blue_background"
                android:text="ALUGAR"
                android:textColor="@android:color/white"
                app:cornerRadius="28dp" />

            <Button
                android:id="@+id/btnADM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@android:color/transparent"
                android:text="ADM"
                android:textColor="@color/unifor_blue"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.TextButton" />


        </LinearLayout>
    </ScrollView>

    <!-- Barra de Navegação -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="8dp"
        android:background="@drawable/card_border"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_nav_fila"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/fila"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_queue"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_meuslivros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/livro_usuario"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_book_user"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/home"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_home"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_desejos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/favoritos"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_heart"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/perfil"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            app:tint="#000000" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>