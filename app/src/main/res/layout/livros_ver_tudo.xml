<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".livros.VerTudoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Header Azul Padrão BDU -->
        <View
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/unifor_blue"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Todos os Livros"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/header_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/header_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/header_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/btn_backReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_button_border"
                    android:contentDescription="@string/voltar"
                    android:padding="8dp"
                    android:rotation="180"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/card_border"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="103dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imgBtnLivro2"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton99"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton98"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton97"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView30"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="        Titulo"
                        android:translationX="5sp"
                        android:translationY="-5sp" />

                    <LinearLayout
                        android:layout_width="89dp"
                        android:layout_height="30dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/autorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="Autor"
                                android:translationX="6sp"
                                android:translationY="-5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imgBtn55"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton96"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton95"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton94"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton93"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton92"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton91"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton90"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton89"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton88"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton87"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton86"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton85"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton84"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton83"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton82"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="127dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton81"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton80"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton79"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />

                        <ImageButton
                            android:id="@+id/imageButton78"
                            android:layout_width="70dp"
                            android:layout_height="99dp"
                            android:layout_marginLeft="15sp"
                            app:srcCompat="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/divider_bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:visibility="invisible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>