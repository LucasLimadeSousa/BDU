<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PixActivity">


    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pix"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="362dp"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_border"
        android:orientation="vertical"
        android:padding="12dp"
        android:translationY="-20sp">

        <ImageButton
            android:id="@+id/btnVoltarPix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10sp"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/border_edittext"
            android:contentDescription="TODO"
            android:padding="8dp"
            android:textAlignment="textStart"
            app:srcCompat="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Escaneie o QR CODE ou use a chave PIX abaixo:"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="match_parent"
            android:layout_height="192dp"
            android:layout_marginTop="15sp"
            android:src="@drawable/ic_launcher_background" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="-20sp"
        android:background="@drawable/card_border"
        android:orientation="vertical"
        android:padding="12dp"
        android:translationY="-20sp">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Chave PIX copia e cola:"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00020126360014BR.GOV.BCB.PIX0114+558899999999520400005303986540510.005802BR5920Fulano de Tal6009SAO PAULO62070503***6304ABCD"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:orientation="horizontal"
        android:translationY="-20sp">

        <ImageButton
            android:id="@+id/imageButton11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0028FF"
            android:src="?attr/actionModeCopyDrawable" />

        <TextView
            android:id="@+id/textView20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copiar chave PIX"
            android:textColor="@color/switch_thumb_active"
            android:textSize="24sp"
            android:textStyle="bold"
            android:translationY="5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:orientation="horizontal"
        android:translationY="30sp">

        <TextView
            android:id="@+id/textView26"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pague em até                                  20:00 Minutos"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="47dp"
        android:layout_height="55dp"
        android:layout_weight="1"
        android:src="@android:drawable/ic_menu_recent_history"
        android:translationX="70sp"
        android:translationY="-155sp" />

</LinearLayout>