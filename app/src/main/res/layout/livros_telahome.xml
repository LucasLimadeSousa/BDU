<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:foregroundTint="#FFFFFF"
    tools:context="com.example.bdu.livros.TelahomeActivity">

    <!-- Header Bar -->

    <View
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/unifor_blue"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/biblioteca_digital"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header_bar" />

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/search_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/header_bar">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#888888" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/buscar"
            android:textColor="#888888" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/nav_top_divider"
        app:layout_constraintTop_toBottomOf="@id/search_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Wishlist Section -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lista_de_desejos_home"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/VerTudo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/ver_tudo"
                    android:textColor="#0033CC"
                    android:textSize="12sp" />
            </RelativeLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/item_livro_a"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_b"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_c"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_d"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_e"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#000000" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />
            </LinearLayout>

            <!-- Popular Books Based on Course Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/VerTudo2"
                    android:text="@string/livros_populares_curso"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/VerTudo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/ver_tudo"
                    android:textColor="#0033CC"
                    android:textSize="12sp" />
            </RelativeLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/item_livro_1"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_2"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_3"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_4"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_5"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#000000" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />
            </LinearLayout>

            <!-- Popular Books Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/livros_populares"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/VerTudo3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/ver_tudo"
                    android:textColor="#0033CC"
                    android:textSize="12sp" />
            </RelativeLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/item_livro_10"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_20"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_30"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_40"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/item_livro_50"
                        layout="@layout/item_book_home"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#000000" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="2dp"
                    android:background="#CCCCCC" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarLivro"
                android:layout_width="222dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:layout_margin="30dp"
                android:layout_marginBottom="50dp"
                android:backgroundTint="@color/blue_background"
                android:text="ADICIONAR LIVRO"
                android:textColor="@android:color/white"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <View
        android:id="@+id/nav_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="8dp"
        android:background="@drawable/card_border"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_nav_fila"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/fila"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_queue"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_meuslivros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/livro_usuario"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_book_user"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/home"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_home"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_desejos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/favoritos"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_heart"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btn_nav_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_border"
            android:contentDescription="@string/perfil"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            app:tint="#000000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>