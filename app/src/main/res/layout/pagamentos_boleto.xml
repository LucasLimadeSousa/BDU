<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boleto Bancário"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_border"
        android:orientation="vertical"
        android:padding="12dp"
        android:translationY="-20sp">

        <ImageButton
            android:id="@+id/imageButton10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10sp"
            android:layout_marginTop="10sp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/border_edittext"
            android:padding="8dp"
            android:textAlignment="textStart"
            app:srcCompat="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textViewValorTotal2"
            android:layout_width="match_parent"
            android:layout_height="71sp"
            android:layout_marginVertical="10sp"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowRadius="60"
            android:text="Valor total: R$00.00"
            android:textSize="28sp"
            android:translationY="-20sp" />

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Linha digitável:"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="34191.79001 01043.510047 91020.150008 6 89790000010000"
            android:textColor="@color/black"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:orientation="horizontal"
        android:translationY="-20sp">

        <ImageButton
            android:id="@+id/imageButton11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#0028FF"
            android:src="?attr/actionModeCopyDrawable" />

        <TextView
            android:id="@+id/textView20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copiar linha digitável"
            android:textColor="@color/switch_thumb_active"
            android:textSize="24sp"
            android:textStyle="bold"
            android:translationY="5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView28"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:gravity="center"
        android:text="AVISO"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView27"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:gravity="center"
        android:text="O prazo de vencimento do boleto é de 3 dias.    Pagamento pode levar de 1-3 dias para compensar."
        android:textColor="@color/black"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn_voltar8"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="85sp"
        android:layout_marginEnd="32sp"
        android:backgroundTint="@color/unifor_blue"
        android:insetLeft="25dp"
        android:insetRight="25dp"
        android:text="Baixar PDF"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:translationY="-40sp"
        app:cornerRadius="28dp"
        app:iconSize="18dp" />

</LinearLayout>